# Cyber Alert DRC — copy to .env and fill secrets. Never commit .env.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3010
APP_URL=http://localhost:3010

# Database (local Postgres — no Docker required)
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/cyberalert

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_SEED_EMAIL=admin@cyberalert.local
ADMIN_SEED_PASSWORD=change-me-admin-password

# AI Gateway (internal only)
AI_GATEWAY_URL=http://127.0.0.1:8090
AI_GATEWAY_SECRET=change-me-ai-gateway-secret
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Payments — Mobile Money (provider backend)
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_SECRET=
PAWAPAY_CALLBACK_IP_ALLOWLIST=
# USD to CDF approximate rate for display/init (server-side)
USD_TO_CDF_RATE=2800

# Email (Resend — same pattern as McBuleli)
RESEND_API_KEY=
RESEND_ALLOW_SEND=false
AUTH_EMAIL_FROM=Cyber Alert DRC <noreply@mcbuleli.org>
AUTH_EMAIL_REPLY_TO=hi@mcbuleli.org
SUPPORT_EMAIL=hi@mcbuleli.org

# Security / abuse
LINK_CHECK_RATE_LIMIT_PER_MIN=10
REPORT_RATE_LIMIT_PER_MIN=5
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional HackerAI (Phase D) — GitHub → VPS, not Render
# Official path: agent token (Settings → Agents) + @hackerai/local on VPS.
# No public standalone HackerAI HTTP API — do not invent endpoints.
HACKERAI_ENABLED=true
HACKERAI_MODE=agent_token
HACKERAI_API_KEY=
HACKERAI_QUICKSTART_TOKEN=
HACKERAI_API_URL=
ANALYSIS_CACHE_TTL_HOURS=24
SECURITY_SCAN_PROVIDER=internal

# SafeFind Location Intelligence (optional — offline commune/GPS still works)
GOOGLE_MAPS_API_KEY=
# Alias accepted by places client
GOOGLE_PLACES_API_KEY=
