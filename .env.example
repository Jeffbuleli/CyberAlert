# Cyber Alert DRC — copy to .env and fill secrets. Never commit .env.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3010
APP_URL=http://localhost:3010

# Database (local default — use Docker compose db on 5433)
DATABASE_URL=postgresql://cyberalert:cyberalert@127.0.0.1:5433/cyberalert

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_SEED_EMAIL=admin@cyberalert.local
ADMIN_SEED_PASSWORD=change-me-admin-password

# AI Gateway (internal only)
AI_GATEWAY_URL=http://127.0.0.1:8090
AI_GATEWAY_SECRET=change-me-ai-gateway-secret
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Payments — PawaPay
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_SECRET=
PAWAPAY_CALLBACK_IP_ALLOWLIST=
# USD to CDF approximate rate for display/init (server-side)
USD_TO_CDF_RATE=2800

# Security / abuse
LINK_CHECK_RATE_LIMIT_PER_MIN=10
REPORT_RATE_LIMIT_PER_MIN=5
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional HackerAI (stub until contracted)
HACKERAI_API_URL=
HACKERAI_API_KEY=
SECURITY_SCAN_PROVIDER=internal
