{
  "name": "cyber-alert-drc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3010",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3010",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deep-worker": "tsx scripts/deep-worker.ts",
    "email:rdpi-survey-broadcast": "tsx --env-file=.env scripts/send-rdpi-survey-broadcast-cyber-alert.ts",
    "test": "tsx --test src/lib/link-analysis/__tests__/*.test.ts src/lib/security/__tests__/*.test.ts src/lib/ai/__tests__/*.test.ts src/lib/security-core/hackerai/__tests__/*.test.ts src/lib/safefind/__tests__/safefind.test.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test:safefind": "tsx --test src/lib/safefind/__tests__/safefind.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
