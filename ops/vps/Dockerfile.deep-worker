# Lightweight image for the optional external deep-worker (profile "deep").
# Not used by default deploy.sh — Fast path stays in web; McBuleli stays in ai.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY tsconfig.json drizzle.config.ts ./
COPY src ./src
COPY scripts ./scripts
ENV NODE_ENV=production
ENV DEEP_WORKER_MODE=external
USER node
CMD ["npx", "tsx", "scripts/deep-worker.ts"]
