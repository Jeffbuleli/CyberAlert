# HackerAI Local Agent — env file (VPS only, never commit real tokens)
#
# Copy to: /etc/cyberalert/hackerai.env
#   sudo install -m 640 -o root -g hackerai ops/vps/hackerai/hackerai.env.example /etc/cyberalert/hackerai.env
# Then fill HACKERAI_API_KEY from hackerai.co → Settings → Agents.

HACKERAI_API_KEY=hsb_REPLACE_ME

# Display name in HackerAI UI (Remote control selector)
HACKERAI_AGENT_NAME=cyberalert-vps

# NEVER set HACKERAI_DANGEROUS=1 on this host.
# Docker sandbox for agent commands requires ≥4 GiB RAM — see VPS_ORGANIZATION.md gate.
HACKERAI_ALLOW_DOCKER_SANDBOX=0
