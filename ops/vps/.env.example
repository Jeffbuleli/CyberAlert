# Copy to ops/vps/.env on the VPS (never commit).

POSTGRES_USER=cyberalert
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cyberalert

NEXT_PUBLIC_APP_URL=https://cyberalert-rdc.org
APP_URL=https://cyberalert-rdc.org
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_SEED_EMAIL=admin@cyberalert-rdc.org
ADMIN_SEED_PASSWORD=change-me-admin-password

AI_GATEWAY_SECRET=change-me-ai-gateway-secret
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PAWAPAY_API_BASE_URL=https://api.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=production
PAWAPAY_CALLBACK_SECRET=
PAWAPAY_CALLBACK_IP_ALLOWLIST=
# alias also accepted: PAWAPAY_CALLBACK_IPS
USD_TO_CDF_RATE=2800

RESEND_API_KEY=
AUTH_EMAIL_FROM=Cyber Alert DRC <noreply@mcbuleli.org>
AUTH_EMAIL_REPLY_TO=hi@mcbuleli.org
SUPPORT_EMAIL=hi@mcbuleli.org

SECURITY_SCAN_PROVIDER=internal
LINK_CHECK_RATE_LIMIT_PER_MIN=20
REPORT_RATE_LIMIT_PER_MIN=10

# Deep worker: inprocess (default, same as today) | external (compose profile deep)
DEEP_WORKER_MODE=inprocess
DEEP_WORKER_CONCURRENCY=1
DEEP_WORKER_POLL_MS=3000

# HackerAI (Phase D) — VPS 153.75.235.176 only (not Render)
# Prefer agent token in /etc/cyberalert/hackerai.env for systemd agent.
# Optional duplicates here for app adapter (agent_token / http_bridge):
HACKERAI_ENABLED=true
HACKERAI_MODE=agent_token
HACKERAI_API_KEY=
HACKERAI_QUICKSTART_TOKEN=
HACKERAI_API_URL=
ANALYSIS_CACHE_TTL_HOURS=24

# SafeFind preview images (Cloudflare R2 — cyberalert-rdc.org media domain)
SAFEFIND_R2_ACCOUNT_ID=
SAFEFIND_R2_BUCKET=cyberalert-safefind
SAFEFIND_R2_ACCESS_KEY_ID=
SAFEFIND_R2_SECRET_ACCESS_KEY=
SAFEFIND_R2_PUBLIC_BASE_URL=https://media.cyberalert-rdc.org
